# Build & dependencies
/vendor/
/node_modules/
# assets/blocks/build/ 刻意「不」忽略 —— 那是要隨發佈包出貨的產物（wp.org 端沒有
# build step，區塊結帳靠這些 bundle 註冊付款方式）。
#
# ⚠️ 不要改回「忽略父目錄 + 用 ! 逐一救回」的寫法：gitignore 規定父目錄被排除後
# 底下的檔案再怎麼 ! 都救不回來，於是 (a) 新增的 provider 會靜默漏掉（linepay 就是
# 這樣沒進 repo），(b) 照 gitignore 語意走檔案系統的打包工具會把整個 build/ 丟掉 ——
# pressship 就是，導致 wp.org 上架版本完全沒有區塊結帳的付款方式。
/.phpunit.cache/
/.phpcs-cache

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Logs
/wp-content/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Composer / NPM lock files: keep them
# (composer.lock and package-lock.json should be committed)

# WP-CLI test artifacts
/tests/tmp/

# Local config
.env
.env.local
phpunit.xml

# Dev-only docs and tooling (kept local, not shipped to wp.org / not in GitHub repo)
/CLAUDE.md
/MEMORY.md
/CHANGELOG.md
/phpcs.xml
/.editorconfig
/scripts/

/.pressship-svn/

# Distribution
/dist/
/*.zip

# E2E screenshots (work artifacts, organized in screenshots/)
/screenshots/
/.playwright-mcp/
