#: src/Modules/Shipping/Methods/AbstractShippingMethod.php:325
msgid "<code>50 + [moksafowo_addfee qty=\"10\"]</code> — 50 plus NT$10 per item"
msgstr ""

#: src/Modules/Shipping/Methods/AbstractShippingMethod.php:326
msgid "<code>[moksafowo_addfee weight=\"20\"]</code> — NT$20 per kilogram"
msgstr ""

#: src/Modules/Shipping/Methods/AbstractShippingMethod.php:327
msgid "Attributes: <code>temp_1</code> = ambient base, <code>temp_2</code> = chilled base, <code>temp_3</code> = frozen base, <code>cool</code> = added when anything needs refrigeration, <code>cool_2</code> = extra for chilled, <code>cool_3</code> = extra for frozen, <code>qty</code> = per item, <code>weight</code> = per kilogram."
