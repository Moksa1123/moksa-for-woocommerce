#: src/Modules/OrderLookup/Ability.php:534
msgid "Optional, can be omitted"
msgstr ""

#: src/Modules/OrderLookup/Ability.php:435
msgid "Enable or disable a shipping method"
msgstr ""

#: src/Modules/OrderLookup/Ability.php:436
msgid "Enable or disable one shipping method in a WooCommerce shipping zone, for example “SmilePay T-Cat ambient” or “ECPay 7-ELEVEN pickup”. Pass the method name directly. This is a destructive action because it changes what customers can choose at checkout — calling the tool only proposes it, and nothing takes effect until the user presses Confirm, so there is no need to ask for confirmation yourself."
msgstr ""

#: src/Modules/OrderLookup/Ability.php:443
msgid "The shipping method name, for example SmilePay T-Cat ambient"
msgstr ""

#: src/Modules/OrderLookup/Ability.php:447
#: src/Modules/OrderLookup/Ability.php:707
#: src/Modules/OrderLookup/Ability.php:798
#: src/Modules/OrderLookup/Ability.php:991
