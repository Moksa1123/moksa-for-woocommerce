#: src/Modules/Shipping/Methods/AbstractShippingMethod.php:323
msgid "<code>100 + [moksafowo_addfee cool_2=\"50\" cool_3=\"100\"]</code> — NT$100 for ambient, plus 50 if the order contains chilled items and plus 100 if it contains frozen items"
