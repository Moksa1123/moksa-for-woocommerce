msgstr ""

#. translators: %d: number of days
#: src/Mcp/Catalog.php:176
#, php-format
msgid "List completed orders from the last %d days that still have no e-invoice number, using get-order-details to confirm each one. Show them as a list with the order number, date and amount. Do not issue any invoices — just tell me which are missing."
msgstr ""

