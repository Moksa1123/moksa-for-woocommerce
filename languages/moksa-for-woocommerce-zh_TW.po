#: src/Modules/Ecpay/Gateways/Atm.php:20
msgid "ECPay ATM transfer"
msgstr "綠界 ATM 轉帳"

#: src/Modules/Ecpay/Gateways/Atm.php:24
msgid "Transfer at an ATM or through online banking within 3 days of receiving the virtual account number."
