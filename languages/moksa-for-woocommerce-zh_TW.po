msgstr "正式 Partner Key"

#: src/Modules/Tappay/Settings/SettingsTab.php:76
msgid "Live webhook signing key"
msgstr "正式 Webhook 簽章密鑰"

#: src/Modules/Tappay/Settings/SettingsTab.php:79
